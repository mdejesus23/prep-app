API_KEY=example
PORT=3000
# Optional. Base URL Swagger UI's "Try it out" sends requests to.
# Leave unset to use the origin serving the docs, which is correct in both
# local dev and production. Only set this to target a different host.
# API_URL=https://bible-themeapp.melnerdz.com
EMAIL_FROM=example.com
SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=example

NODE_ENV=development

MONGO_USER=example
MONGO_PASSWORD=example
MONGO_DEFAULT_DATABASE=preparation

JWT_SECRET=example
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=90

FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

CLOUD_NAME=dfrnd2uks
CLOUD_API_KEY=example
CLOUD_API_SECRET=example
CLOUDINARY_URL=cloudinary://example:example